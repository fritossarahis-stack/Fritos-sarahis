<div class="overlay" id="adminOverlay"><section class="sheet"><div class="sheethead"><h2>🔐 Administración</h2><button class="close" data-close="adminOverlay">×</button></div><div id="loginBox"><p class="notice">Inicia sesión con tu cuenta administradora.</p><form id="loginForm"><div class="field"><label>Correo electrónico</label><input id="email" type="email" required autocomplete="username"></div><div class="field"><label>Contraseña</label><input id="password" type="password" required autocomplete="current-password"></div><button class="btn dark block">Iniciar sesión</button></form></div><div id="adminPanel" hidden><div class="rowbtn"><button id="newProduct" class="btn primary">＋ Nuevo producto</button><button id="logout" class="btn light">Cerrar sesión</button></div><p id="adminMsg" class="status"></p><div id="editor" class="adminbox" hidden><h3 id="editorTitle">Nuevo producto</h3><form id="productForm"><input id="pid" type="hidden"><div class="field"><label>Nombre *</label><input id="pname" required maxlength="100" placeholder="Pizza de queso"></div><div class="field"><label>Descripción</label><textarea id="pdesc" maxlength="500"></textarea></div><div class="field"><label>Precio base *</label><input id="pprice" type="number" min="0" step="0.01" required></div><div class="field"><label>Categoría *</label><input id="pcat" required maxlength="70" list="catOptions" placeholder="Pizzas"><datalist id="catOptions"><option>Pizzas</option><option>Pastelitos</option><option>Empanadas</option><option>Tequeños</option><option>Fritos</option><option>Bebidas</option><option>Postres</option></datalist></div><div class="field"><label>Foto del producto (desde tu teléfono)</label><input id="pfile" type="file" accept="image/png,image/jpeg,image/webp"><input id="pimage" type="url" maxlength="1000" placeholder="O pega aquí un enlace público de foto"><img id="imagePreview" class="preview hidden" alt="Vista previa"></div><div class="adminbox"><h3>Extras opcionales</h3><p class="muted">Uno por línea. Escribe el nombre y el precio adicional separados por |. Ejemplo: Jamón|1.00</p><textarea id="pextras" placeholder="Jamón|1.00&#10;Queso extra|1.50&#10;Tocineta|2.00"></textarea></div><div class="adminbox"><h3>Combo de sabores (opcional)</h3><label class="choice"><input id="comboEnabled" type="checkbox"> Este producto es un combo con selección de sabores</label><div id="comboFields" class="hidden"><div class="field"><label>Cantidad exacta de sabores *</label><input id="comboQty" type="number" min="1" max="30" step="1" value="3"></div><div class="field"><label>Sabores disponibles (separados por coma) *</label><textarea id="comboFlavors" placeholder="Pollo, Carne, Queso, Papa"></textarea></div><p class="muted">El cliente tendrá que seleccionar exactamente esa cantidad. Puede repetir sabores.</p></div></div><div class="field"><label class="choice"><input id="pactive" type="checkbox" checked> Producto activo (visible)</label></div><div class="rowbtn"><button class="btn primary">Guardar producto</button><button id="cancelEdit" type="button" class="btn light">Cancelar</button></div></form></div><div class="adminbox"><h3>Productos del menú</h3><div id="adminProducts">Cargando…</div></div></div></section></div>

<script>
(()=>{"use strict";
const SUPABASE_URL="https://ncfgdnsfjoesjwffnjtp.supabase.co";
const SUPABASE_KEY="sb_publishable_GylbgLtvi-yzxuYJm2Y9Ag_YCsVfO1x";
const WHATSAPP_PHONE="584146489828";
const db=window.supabase.createClient(SUPABASE_URL,SUPABASE_KEY),$=id=>document.getElementById(id);
let products=[],cart=[],category="Todos",adminUser=null,selectedProduct=null,selectedExtras=[],selectedFlavors=[],gps=null,pendingImageUrl="";
const esc=s=>String(s??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
const money=n=>new Intl.NumberFormat("es-CO",{style:"currency",currency:"COP",minimumFractionDigits:2,maximumFractionDigits:2}).format(Number(n)||0);
function emoji(c){c=String(c||"").toLowerCase();if(c.includes("pizza"))return"🍕";if(c.includes("pastel")||c.includes("empan"))return"🥟";if(c.includes("teque"))return"🧀";if(c.includes("bebida")||c.includes("jugo"))return"🥤";if(c.includes("postre"))return"🍰";if(c.includes("frit"))return"🍟";return"🍽️"}
function status(m,type=""){ $("adminMsg").textContent=m;$("adminMsg").className="status "+type}
function open(id){$(id).classList.add("open");document.body.style.overflow="hidden"}
function close(id){$(id).classList.remove("open");if(!document.querySelector(".overlay.open"))document.body.style.overflow=""}
document.querySelectorAll("[data-close]").forEach(b=>b.onclick=()=>close(b.dataset.close));
document.querySelectorAll(".overlay").forEach(o=>o.onclick=e=>{if(e.target===o)close(o.id)});
async function settings(){const {data,error}=await db.from("menu_settings").select("*").limit(1).maybeSingle();if(!error&&data){if(data.business_name) $("businessName").textContent=data.business_name;if(data.tagline)$("tagline").textContent=data.tagline;if(/^#[0-9a-f]{6}$/i.test(data.brand_color||""))document.documentElement.style.setProperty("--gold",data.brand_color)}}
async function loadProducts(){const {data,error}=await db.from("products").select("id,name,description,price,category,image_url,active,extras,combo_config").eq("active",true).order("name");if(error){$("menu").innerHTML='<div class="empty">No pudimos cargar el menú. Si acabas de actualizar, ejecuta primero el SQL de configuración.</div>';console.error(error);return}products=data||[];renderCats();renderMenu()}
function renderCats(){let cats=["Todos",...new Set(products.map(p=>(p.category||"Otros").trim()).filter(Boolean))];if(!cats.includes(category))category="Todos";$("categories").innerHTML=cats.map(c=>`<button class="cat ${category===c?"active":""}" data-cat="${esc(c)}">${c==="Todos"?"✨":emoji(c)} ${esc(c)}</button>`).join("");$("categories").querySelectorAll("button").forEach(b=>b.onclick=()=>{category=b.dataset.cat;renderCats();renderMenu()})}
function renderMenu(){let q=$("search").value.trim().toLowerCase(),list=products.filter(p=>(category==="Todos"||(p.category||"Otros").trim()===category)&&[p.name,p.description,p.category].some(v=>String(v||"").toLowerCase().includes(q)));$("catTitle").textContent=category==="Todos"?"Todos los productos":category;$("count").textContent=`${list.length} producto(s)`;if(!list.length){$("menu").innerHTML='<div class="empty">No hay productos en esta categoría todavía ❤️</div>';return}$("menu").innerHTML=list.map(p=>`<article class="card" data-product="${esc(p.id)}">${p.image_url?`<img class="photo" src="${esc(p.image_url)}" alt="${esc(p.name)}" loading="lazy" onerror="this.outerHTML='<div class=&quot;placeholder&quot;>🍽️</div>'">`:`<div class="placeholder">${emoji(p.category)}</div>`}<div class="body"><h3>${esc(p.name)}</h3><p class="desc">${esc(p.description||"Preparado con mucho sabor.")}</p><div class="foot"><span class="price">${money(p.price)}</span><button class="add" data-open-product="${esc(p.id)}">Ver y agregar</button></div></div></article>`).join("");$("menu").querySelectorAll("[data-open-product]").forEach(b=>b.onclick=()=>showDetails(b.dataset.openProduct))}
$("search").addEventListener("input",renderMenu);
function parseExtras(p){return Array.isArray(p.extras)?p.extras:[]}
function comboOf(p){return p.combo_config&&p.combo_config.enabled?p.combo_config:null}
function showDetails(id){let p=products.find(x=>String(x.id)===String(id));if(!p)return;selectedProduct=p;selectedExtras=[];selectedFlavors=[];$("detailTitle").textContent=p.name;let html=p.image_url?`<img class="detailphoto" src="${esc(p.image_url)}" alt="${esc(p.name)}">`:"";html+=`<p>${esc(p.description||"")}</p><p><b>Precio base: ${money(p.price)}</b></p>`;let ex=parseExtras(p);if(ex.length){html+='<h3>Personaliza con extras</h3><p class="muted">Puedes elegir varios.</p>'+ex.map((x,i)=>`<label class="choice"><input type="checkbox" data-extra="${i}"><span>${esc(x.name)} <b>+${money(x.price)}</b></span></label>`).join("")}let co=comboOf(p);if(co){html+=`<h3>Elige ${Number(co.quantity)} sabores para tu combo</h3><p class="muted">Selecciona exactamente ${Number(co.quantity)}. Puedes repetir sabores.</p><div id="flavorChoices">${(co.flavors||[]).map((f,i)=>`<div class="choice"><span style="flex:1">${esc(f)}</span><button class="mini" data-flavor-minus="${i}">−</button><b id="flavorCount${i}">0</b><button class="mini" data-flavor-plus="${i}">+</button></div>`).join("")}</div><p id="flavorStatus" class="notice"></p>`}$("detailContent").innerHTML=html;$("detailContent").querySelectorAll("[data-extra]").forEach(c=>c.onchange=()=>{let i=Number(c.dataset.extra);if(c.checked)selectedExtras.push(i);else selectedExtras=selectedExtras.filter(x=>x!==i);updateDetailTotal()});if(co){$("detailContent").querySelectorAll("[data-flavor-plus]").forEach(b=>b.onclick=()=>changeFlavor(Number(b.dataset.flavorPlus),1));$("detailContent").querySelectorAll("[data-flavor-minus]").forEach(b=>b.onclick=()=>changeFlavor(Number(b.dataset.flavorMinus),-1))}updateDetailTotal();open("detailOverlay")}
function changeFlavor(i,d){let co=comboOf(selectedProduct),limit=Number(co.quantity),sum=selectedFlavors.reduce((a,b)=>a+b,0);if(d>0&&sum>=limit)return;selectedFlavors[i]=Math.max(0,(selectedFlavors[i]||0)+d);$("detailContent").querySelectorAll("[id^=flavorCount]").forEach((el,j)=>el.textContent=selectedFlavors[j]||0);let n=selectedFlavors.reduce((a,b)=>a+b,0);$("flavorStatus").textContent=`Has seleccionado ${n} de ${limit}.`;updateDetailTotal()}
function updateDetailTotal(){if(!selectedProduct)return;let extra=parseExtras(selectedProduct).reduce((s,x,i)=>s+(selectedExtras.includes(i)?Number(x.price):0),0);$("detailTotal").textContent="Precio por unidad: "+money(Number(selectedProduct.price)+extra)}
$("detailAdd").onclick=()=>{if(!selectedProduct)return;let co=comboOf(selectedProduct),flavors=[];if(co){let count=selectedFlavors.reduce((a,b)=>a+b,0);if(count!==Number(co.quantity)){alert(`Debes seleccionar exactamente ${co.quantity} sabores.`);return}(co.flavors||[]).forEach((f,i)=>{for(let n=0;n<(selectedFlavors[i]||0);n++)flavors.push(f)})}let extras=parseExtras(selectedProduct).filter((x,i)=>selectedExtras.includes(i)).map(x=>({name:x.name,price:Number(x.price)}));let unit=Number(selectedProduct.price)+extras.reduce((s,x)=>s+x.price,0);cart.push({key:(crypto.randomUUID?crypto.randomUUID():String(Date.now()+Math.random())),p:selectedProduct,qty:1,extras,flavors,unit});renderCart();close("detailOverlay")};
function total(){return cart.reduce((s,i)=>s+i.unit*i.qty,0)}
function renderCart(){let n=cart.reduce((s,i)=>s+i.qty,0);$("cartbar").hidden=!n;$("cartcount").textContent=n;$("cartbarTotal").textContent=money(total());$("cartItems").innerHTML=cart.length?cart.map(i=>`<div class="item"><div><b>${esc(i.p.name)}</b><br><small>${money(i.unit)} c/u</small>${i.extras.length?`<br><small>Extras: ${i.extras.map(x=>esc(x.name)).join(", ")}</small>`:""}${i.flavors.length?`<br><small>Sabores: ${i.flavors.map(esc).join(", ")}</small>`:""}<br><b>${money(i.unit*i.qty)}</b></div><div class="qty"><button data-minus="${esc(i.key)}">−</button><b>${i.qty}</b><button data-plus="${esc(i.key)}">+</button></div></div>`).join(""):'<p class="notice">Tu carrito está vacío.</p>';$("cartTotal").textContent="Total: "+money(total());$("cartItems").querySelectorAll("[data-minus]").forEach(b=>b.onclick=()=>changeQty(b.dataset.minus,-1));$("cartItems").querySelectorAll("[data-plus]").forEach(b=>b.onclick=()=>changeQty(b.dataset.plus,1))}
function changeQty(key,d){let i=cart.find(x=>x.key===key);if(!i)return;i.qty+=d;if(i.qty<=0)cart=cart.filter(x=>x.key!==key);renderCart()}
$("cartbar").onclick=()=>{renderCart();open("cartOverlay")};$("checkoutGo").onclick=()=>{if(!cart.length){alert("Agrega un producto primero.");return}close("cartOverlay");open("checkoutOverlay")};
$("service").onchange=()=>{let delivery=$("service").value==="Delivery";$("deliveryFields").classList.toggle("hidden",!delivery);$("address").required=delivery;if(!delivery){gps=null;$("locationStatus").textContent=""}};
$("getLocation").onclick=()=>{if(!navigator.geolocation){$("locationStatus").textContent="Tu navegador no permite obtener GPS.";return}$("locationStatus").textContent="Solicitando ubicación…";navigator.geolocation.getCurrentPosition(pos=>{gps={lat:pos.coords.latitude,lon:pos.coords.longitude};$("locationStatus").textContent="Ubicación obtenida. Se enviará el enlace del mapa por WhatsApp."},err=>{$("locationStatus").textContent="No se pudo obtener GPS. Puedes escribir tu dirección manualmente."},{enableHighAccuracy:true,timeout:12000,maximumAge:60000})};
$("checkoutForm").onsubmit=e=>{e.preventDefault();if(!cart.length)return;if($("service").value==="Delivery"&&!$("address").value.trim()){alert("Escribe la dirección de entrega.");return}let lines=["¡Hola! Quiero hacer un pedido en "+$("businessName").textContent+".","",`Nombre: ${$("customer").value.trim()}`,`Servicio: ${$("service").value}`];if($("service").value==="Delivery"){lines.push("Dirección: "+$("address").value.trim());if(gps)lines.push(`Ubicación GPS: https://www.google.com/maps?q=${gps.lat},${gps.lon}`)}lines.push("","Mi pedido:");cart.forEach(i=>{lines.push(`• ${i.qty} x ${i.p.name} — ${money(i.unit*i.qty)}`);if(i.extras.length)lines.push("  Extras: "+i.extras.map(x=>`${x.name} (+${money(x.price)})`).join(", "));if(i.flavors.length)lines.push("  Sabores: "+i.flavors.join(", "))});lines.push("","TOTAL: "+money(total()));if($("note").value.trim())lines.push("","Nota: "+$("note").value.trim());lines.push("","Quedo pendiente de la confirmación. ¡Gracias!");window.open("https://wa.me/"+WHATSAPP_PHONE+"?text="+encodeURIComponent(lines.join("\n")),"_blank","noopener")};
$("openAdmin").onclick=async()=>{open("adminOverlay");await checkSession()};
$("loginForm").onsubmit=async e=>{e.preventDefault();status("Iniciando sesión…");let {data,error}=await db.auth.signInWithPassword({email:$("email").value.trim(),password:$("password").value});if(error){status("No se pudo iniciar sesión: "+error.message,"error");return}adminUser=data.user;$("password").value="";await showAdmin()};
async function checkSession(){let {data}=await db.auth.getSession();adminUser=data.session?.user||null;$("loginBox").hidden=!!adminUser;$("adminPanel").hidden=!adminUser;if(adminUser)await showAdmin()}
async function showAdmin(){$("loginBox").hidden=true;$("adminPanel").hidden=false;status("Sesión iniciada como "+(adminUser?.email||"administrador"),"ok");resetForm();await loadAdmin()}
$("logout").onclick=async()=>{await db.auth.signOut();adminUser=null;$("loginBox").hidden=false;$("adminPanel").hidden=true;status("Sesión cerrada.")};
function resetForm(){$("productForm").reset();$("pid").value="";$("pactive").checked=true;$("editorTitle").textContent="Nuevo producto";$("comboFields").classList.add("hidden");$("imagePreview").classList.add("hidden");pendingImageUrl=""}
$("newProduct").onclick=()=>{resetForm();$("editor").hidden=false;$("editor").scrollIntoView({behavior:"smooth"})};$("cancelEdit").onclick=()=>{$("editor").hidden=true;resetForm()};
$("comboEnabled").onchange=()=> $("comboFields").classList.toggle("hidden",!$("comboEnabled").checked);
$("pfile").onchange=()=>{let f=$("pfile").files[0];if(!f){$("imagePreview").classList.add("hidden");return}if(!["image/jpeg","image/png","image/webp"].includes(f.type)){alert("Selecciona una imagen JPG, PNG o WEBP.");$("pfile").value="";return}if(f.size>5*1024*1024){alert("La imagen debe pesar máximo 5 MB.");$("pfile").value="";return}let u=URL.createObjectURL(f);$("imagePreview").src=u;$("imagePreview").classList.remove("hidden")};
async function uploadImage(){let f=$("pfile").files[0];if(!f)return $("pimage").value.trim()||null;let ext=f.name.split(".").pop().toLowerCase().replace(/[^a-z0-9]/g,"")||"jpg",path=`${Date.now()}-${Math.random().toString(36).slice(2)}.${ext}`;let {error}=await db.storage.from("product-images").upload(path,f,{upsert:false,contentType:f.type});if(error)throw new Error("No se pudo subir la imagen: "+error.message+" Comprueba que el bucket product-images permita subir archivos al administrador.");let {data}=db.storage.from("product-images").getPublicUrl(path);return data.publicUrl}
async function loadAdmin(){let {data,error}=await db.from("products").select("id,name,description,price,category,image_url,active,extras,combo_config").order("name");if(error){$("adminProducts").textContent="Error: "+error.message;status("No se pudo cargar la lista: "+error.message,"error");return}if(!data?.length){$("adminProducts").innerHTML='<p class="notice">Todavía no hay productos. Pulsa “Nuevo producto”.</p>';return}$("adminProducts").innerHTML=data.map(p=>`<div class="adminrow"><div><b>${esc(p.name)}</b><small>${esc(p.category||"Sin categoría")} · ${money(p.price)}</small><small>${p.active?"Activo":"Inactivo"}${p.combo_config?.enabled?" · Combo":""}</small></div><div class="rowbtn"><button class="mini" data-edit="${esc(p.id)}">Editar</button><button class="mini" data-toggle="${esc(p.id)}" data-active="${p.active}">${p.active?"Ocultar":"Activar"}</button><button class="mini" data-delete="${esc(p.id)}">Borrar</button></div></div>`).join("");$("adminProducts").querySelectorAll("[data-edit]").forEach(b=>b.onclick=()=>edit(b.dataset.edit,data));$("adminProducts").querySelectorAll("[data-toggle]").forEach(b=>b.onclick=()=>toggle(b.dataset.toggle,b.dataset.active!=="true"));$("adminProducts").querySelectorAll("[data-delete]").forEach(b=>b.onclick=()=>remove(b.dataset.delete))}
function edit(id,rows){let p=rows.find(x=>String(x.id)===String(id));if(!p)return;$("pid").value=p.id;$("pname").value=p.name||"";$("pdesc").value=p.description||"";$("pprice").value=p.price;$("pcat").value=p.category||"";$("pimage").value=p.image_url||"";$("pactive").checked=!!p.active;$("pextras").value=(Array.isArray(p.extras)?p.extras:[]).map(x=>`${x.name}|${Number(x.price).toFixed(2)}`).join("\n");let co=p.combo_config||{};$("comboEnabled").checked=!!co.enabled;$("comboFields").classList.toggle("hidden",!co.enabled);$("comboQty").value=co.quantity||3;$("comboFlavors").value=(co.flavors||[]).join(", ");$("editorTitle").textContent="Editar producto";$("editor").hidden=false;$("editor").scrollIntoView({behavior:"smooth"})}
function readExtras(){let lines=$("pextras").value.split("\n").map(x=>x.trim()).filter(Boolean),out=[];for(let line of lines){let parts=line.split("|");if(parts.length<2||!parts[0].trim()||!Number.isFinite(Number(parts[1].trim()))||Number(parts[1].trim())<0)throw new Error(`Revisa el extra: "${line}". Usa Nombre|Precio.`);out.push({name:parts[0].trim(),price:Number(parts[1].trim())})}return out}
$("productForm").onsubmit=async e=>{e.preventDefault();if(!adminUser){status("Inicia sesión primero.","error");return}let name=$("pname").value.trim(),category=$("pcat").value.trim(),price=Number($("pprice").value),id=$("pid").value;try{if(!name||!category||!Number.isFinite(price)||price<0)throw new Error("Revisa nombre, categoría y precio.");let extras=readExtras(),combo=null;if($("comboEnabled").checked){let quantity=Number($("comboQty").value),flavors=$("comboFlavors").value.split(",").map(x=>x.trim()).filter(Boolean);if(!Number.isInteger(quantity)||quantity<1||quantity>30||!flavors.length)throw new Error("Completa la cantidad y los sabores del combo.");combo={enabled:true,quantity,flavors}}let image_url=await uploadImage();if(image_url&&!/^https?:\/\//i.test(image_url))throw new Error("El enlace de la imagen no es válido.");let row={name,description:$("pdesc").value.trim(),price,category,image_url,active:$("pactive").checked,extras,combo_config:combo};status("Guardando producto…");let result=id?await db.from("products").update(row).eq("id",id):await db.from("products").insert(row);if(result.error)throw new Error(result.error.message);status("¡Producto guardado correctamente!","ok");$("editor").hidden=true;resetForm();await loadProducts();await loadAdmin()}catch(err){status("Error: "+err.message,"error")}};
async function toggle(id,active){let {error}=await db.from("products").update({active}).eq("id",id);if(error){status("Error al cambiar estado: "+error.message,"error");return}status(active?"Producto activado.":"Producto ocultado.","ok");await loadProducts();await loadAdmin()}
async function remove(id){if(!confirm("¿Seguro que quieres borrar este producto?"))return;let {error}=await db.from("products").delete().eq("id",id);if(error){status("No se pudo borrar: "+error.message,"error");return}status("Producto eliminado.","ok");await loadProducts();await loadAdmin()}
db.auth.onAuthStateChange((_event,session)=>{adminUser=session?.user||null});
(async()=>{await settings();await loadProducts();renderCart()})();
})();
</script>
