ckground:#171717;color:#fff;border:0;border-radius:15px;padding:14px;display:flex;justify-content:space-between;align-items:center;box-shadow:0 8px 30px #0004;z-index:5}.cartbar[hidden]{display:none}.gold{color:#f5cb72}.adminlink{display:block;margin:28px auto 0;border:1px solid #ddd;background:#fff;border-radius:8px;padding:8px;color:#666;font-size:12px}.footnote{text-align:center;color:#777;font-size:12px;padding:15px}.overlay{display:none;position:fixed;inset:0;background:#0009;z-index:10;align-items:flex-end;justify-content:center}.overlay.open{display:flex}.sheet{background:#fff;border-radius:22px 22px 0 0;padding:18px;width:min(650px,100%);max-height:94vh;overflow:auto}.sheethead{display:flex;justify-content:space-between;align-items:center;gap:10px}.sheethead h2{margin:0}.close{border:0;border-radius:50%;width:36px;height:36px;font-size:22px;flex:none}.field{display:grid;gap:5px;margin:12px 0}.field label{font-weight:700;font-size:13px}.field input:not([type=checkbox]),.field textarea,.field select{width:100%;border:1px solid #ddd;border-radius:10px;padding:11px;background:#fff}.field textarea{min-height:70px}.btn{border:0;border-radius:11px;padding:12px;font-weight:750}.primary{background:var(--gold);color:#171717}.light{background:#eee;color:#222}.block{width:100%;margin-top:8px}.notice{font-size:12px;color:#777}.item{display:flex;justify-content:space-between;gap:10px;padding:12px 0;border-bottom:1px solid var(--line)}.qty{display:flex;align-items:center;gap:7px}.qty button{border:1px solid #ddd;border-radius:7px;background:#fff;width:29px;height:29px}.status{font-size:13px;overflow-wrap:anywhere}.error{color:#b42318}.ok{color:#177245}.adminrow{display:flex;justify-content:space-between;align-items:center;gap:8px;padding:10px 0;border-bottom:1px solid var(--line)}.adminrow small{display:block;color:#777}.mini{border:1px solid #ddd;background:#fff;border-radius:7px;padding:6px;font-size:12px}.adminbox{border:1px solid var(--line);border-radius:13px;padding:12px;margin:12px 0}.rowbtn{display:flex;gap:7px;flex-wrap:wrap}.detailphoto{width:100%;max-height:240px;object-fit:cover;border-radius:14px;margin:12px 0}.choice{display:flex;align-items:center;gap:9px;padding:9px 2px;border-bottom:1px solid #eee;font-size:14px}.choice input{width:18px;height:18px;flex:none}.muted{color:#777;font-size:12px}.totalbig{font-size:19px;font-weight:850}.preview{width:100%;max-height:150px;object-fit:cover;border-radius:10px;margin-top:8px}.hidden{display:none!important}
